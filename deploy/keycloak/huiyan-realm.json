{
  "realm": "huiyan",
  "enabled": true,
  "displayName": "慧眼 AI 教学实训平台",
  "registrationAllowed": false,
  "resetPasswordAllowed": true,
  "rememberMe": false,
  "verifyEmail": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "passwordPolicy": "length(10) and upperCase(1) and lowerCase(1) and digits(1) and notUsername and passwordHistory(3)",
  "bruteForceProtected": true,
  "permanentLockout": false,
  "maxFailureWaitSeconds": 900,
  "minimumQuickLoginWaitSeconds": 60,
  "waitIncrementSeconds": 60,
  "quickLoginCheckMilliSeconds": 1000,
  "maxDeltaTimeSeconds": 43200,
  "failureFactor": 5,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 28800,
  "accessTokenLifespan": 300,
  "offlineSessionIdleTimeout": 2592000,
  "eventsEnabled": true,
  "eventsExpiration": 2592000,
  "adminEventsEnabled": true,
  "adminEventsDetailsEnabled": true,
  "roles": {
    "realm": [
      {
        "name": "STUDENT",
        "description": "学员（住培医师）"
      },
      {
        "name": "TEACHER",
        "description": "带教医师"
      },
      {
        "name": "ADMIN",
        "description": "系统管理员"
      },
      {
        "name": "PATIENT",
        "description": "体检者"
      }
    ]
  },
  "clients": [
    {
      "clientId": "huiyan-frontend",
      "name": "慧眼前端（公共客户端，PKCE）",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:5174/*",
        "http://localhost:8080/*",
        "https://*/callback"
      ],
      "webOrigins": [
        "+"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      }
    },
    {
      "clientId": "huiyan-backend",
      "name": "慧眼后端（机密客户端，校验令牌 / 代表用户访问 PACS）",
      "enabled": true,
      "publicClient": false,
      "secret": "huiyan-backend-local-dev-secret",
      "standardFlowEnabled": false,
      "serviceAccountsEnabled": true,
      "directAccessGrantsEnabled": true
    },
    {
      "clientId": "orthanc",
      "name": "Orthanc PACS（受保护资源）",
      "enabled": true,
      "publicClient": false,
      "secret": "orthanc-local-dev-secret",
      "standardFlowEnabled": false,
      "serviceAccountsEnabled": true,
      "directAccessGrantsEnabled": false
    }
  ],
  "users": [
    {
      "username": "teacher",
      "enabled": true,
      "emailVerified": true,
      "firstName": "带教",
      "lastName": "医师",
      "credentials": [
        {
          "type": "password",
          "value": "Huiyan@2026",
          "temporary": false
        }
      ],
      "realmRoles": [
        "default-roles-huiyan",
        "TEACHER"
      ],
      "email": "teacher@huiyan.local"
    },
    {
      "username": "student",
      "enabled": true,
      "emailVerified": true,
      "firstName": "住培",
      "lastName": "医师",
      "credentials": [
        {
          "type": "password",
          "value": "Huiyan@2026",
          "temporary": false
        }
      ],
      "realmRoles": [
        "default-roles-huiyan",
        "STUDENT"
      ],
      "email": "student@huiyan.local"
    },
    {
      "username": "service-account-huiyan-backend",
      "enabled": true,
      "email": "service-account-huiyan-backend@huiyan.local",
      "emailVerified": true,
      "serviceAccountClientId": "huiyan-backend",
      "realmRoles": [
        "default-roles-huiyan",
        "ADMIN"
      ]
    }
  ]
}
