# =================================================================
# 慧眼教学云后端 · 环境变量配置模板
# 复制本文件为 .env，按实际环境修改
# =================================================================

# ---------- 项目基础 ----------
PROJECT_NAME=慧眼教学云后端服务
PROJECT_VERSION=1.0.0
API_V1_PREFIX=/api/v1
DEBUG=True

# ---------- 服务地址 ----------
HOST=0.0.0.0
PORT=8000

# ---------- 数据库（MySQL）----------
# 格式：mysql+pymysql://用户名:密码@主机:端口/数据库名?charset=utf8mb4
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=edu_eye

# ---------- JWT 配置 ----------
# 生产环境务必修改 SECRET_KEY，建议使用：openssl rand -hex 32
SECRET_KEY=change-me-in-production-1234567890abcdef1234567890abcdef
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# ---------- 跨域 ----------
# 多个域名用英文逗号分隔；生产请精确配置，禁止使用 *
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173

# ---------- 文件存储 ----------
STATIC_URL=/static
UPLOAD_DIR=app/static
AVATAR_SUBDIR=avatars
AVATAR_MAX_SIZE_MB=5
AVATAR_ALLOWED_EXT=.jpg,.jpeg,.png,.webp,.bmp

# ---------- 算法服务器（CSU-EYES / DRGCNN）----------
# AI 辅助检测经本后端转发到算法机。二选一：
#   公网（经 SSH 隧道，慢）：      http://113.219.243.122:9050
#   内网直连（后端与算法机同网段，快）： http://192.168.2.103:5000
# 内网部署时用 5000 直连；公网部署改回 9050。
CSU_EYES_BASE_URL=http://192.168.2.103:5000
DRGCNN_ENABLED=True
DRGCNN_BASE_URL=http://192.168.2.103:5000
